{
  "name": "music-ratings",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A private reference edition of your own taste — rate and rank your Spotify music locally, sync to your own OneDrive.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json",
    "typecheck": "npm run check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run format:check && npm run lint && npm run check && npm test && npm run build"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.20.0",
    "@fontsource-variable/libre-franklin": "^5.3.0",
    "idb": "^8.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^24.13.2",
    "eslint": "^9.39.0",
    "eslint-plugin-svelte": "^3.23.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
