# music-ratings — build-time configuration
#
# Every value here is PUBLIC. This app has no server and no secrets.
# A Spotify client secret is never used, never required, and must never be added.
# Copy this file to `.env.local` and fill in your own IDs, or leave it out
# entirely and enter the same values in Settings at runtime.

# --- Spotify -----------------------------------------------------------------
# Client ID from https://developer.spotify.com/dashboard (create an app, choose
# "Web API", and add the redirect URI below to the app's Redirect URIs list).
# Authorization Code with PKCE is used, so no client secret exists.
VITE_SPOTIFY_CLIENT_ID=

# Must match a Redirect URI registered on the Spotify app *exactly*.
# Leave blank to use the app's own origin + base path at runtime.
# Example for local dev: http://127.0.0.1:5173/callback
VITE_SPOTIFY_REDIRECT_URI=

# --- Microsoft / OneDrive (optional sync) ------------------------------------
# Application (client) ID of an Azure AD app registration with a
# "Single-page application" redirect URI equal to your deployed origin.
# Delegated permissions needed: Files.ReadWrite.AppFolder, User.Read.
# Do NOT reuse a client ID from another project.
VITE_ONEDRIVE_CLIENT_ID=

# --- Deployment --------------------------------------------------------------
# Base public path. "/" for a custom domain, "/<repo>/" for GitHub Pages
# project sites.
VITE_BASE_PATH=/
